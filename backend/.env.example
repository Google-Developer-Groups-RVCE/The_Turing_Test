# ------------------------------------------------------------------
# Backend environment variables — copy this file to `.env` for local
# development. In Kubernetes, these are injected via ConfigMaps
# (non-secret values) and Secrets (REDIS_PASSWORD, JWT_SECRET, etc.)
# instead of a real .env file — see architecture Section 10.
# ------------------------------------------------------------------

# ---- Core ----
NODE_ENV=development
PORT=5000

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ---- Logging ----
# One of: error, warn, info, http, debug
LOG_LEVEL=debug

# ---- Auth (reserved for Module 3 — Authentication) ----
# Not required for Module 1 (Backend Foundation), declared here so the
# .env shape doesn't change later.
JWT_SECRET=
